# Настройки send.php. На сервере: /etc/parshukov-site/form.env, владелец root:www-data, права 640.
# Значения без кавычек. Пароль в репозиторий не коммитить.

# Куда слать заявки (можно несколько через запятую)
MAIL_TO=Vadim.parshukov.199d@mail.ru

# SMTP mail.ru: порт 465 + ssl. Пароль — «пароль для внешних приложений», не основной пароль почты.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=Vadim.parshukov.199d@mail.ru
SMTP_PASS=
SMTP_FROM=Vadim.parshukov.199d@mail.ru
SMTP_FROM_NAME=Сайт Вадима Паршукова

# Домены, с которых принимаются заявки (кроме текущего хоста), через запятую
ALLOWED_HOSTS=

# Яндекс SmartCaptcha: серверный ключ. Пусто — капча выключена, работают ловушка и проверка времени.
SMARTCAPTCHA_SERVER_KEY=
